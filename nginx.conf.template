# HTTP - Redirect to HTTPS
server {
    listen 80;
    server_name findlocally.in www.findlocally.in;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS - Angular + Spring Boot
server {
    listen 443 ssl;
    server_name findlocally.in www.findlocally.in;

    ssl_certificate /etc/letsencrypt/live/findlocally.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/findlocally.in/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}